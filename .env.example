# Turnwise — sao chép thành .env rồi chỉnh. File .env không được commit.
#
# Không có khoá API nào ở đây, và sẽ không bao giờ có: SPEC.md §6 cấm phụ thuộc
# dịch vụ đám mây trên đường chạy chính. Mọi mô hình chạy cục bộ trên CPU.
# Mọi biến đọc qua src/turnwise/config.py (pydantic-settings), không đọc ở nơi khác.

# --- Cấu hình ---
# Đường dẫn file cấu hình. Đổi sang configs/baseline/silence-threshold.yaml để chạy B1.
TURNWISE_CONFIG=configs/default.yaml

# --- Ghi log ---
# DEBUG | INFO | WARNING | ERROR
TURNWISE_LOG_LEVEL=INFO
# Nơi telemetry.collector ghi sự kiện quyết định lượt nói (JSONL).
TURNWISE_TELEMETRY_DIR=reports/telemetry

# --- Thiết bị âm thanh ---
# Bỏ trống để dùng thiết bị mặc định của hệ điều hành.
# Liệt kê thiết bị: uv run python -c "import sounddevice; print(sounddevice.query_devices())"
# Trên Windows nên chọn thiết bị thuộc host API WASAPI để có độ trễ thấp nhất.
TURNWISE_INPUT_DEVICE=
TURNWISE_OUTPUT_DEVICE=

# --- Mô hình cục bộ ---
# Thư mục models/ nằm ngoài git; file tham chiếu bằng checksum trong data/manifests/.
TURNWISE_MODEL_DIR=models/exported

# --- Transport ---
# Client WebRTC dùng khi chạy `uv run turnwise dev`.
TURNWISE_DEV_HOST=127.0.0.1
TURNWISE_DEV_PORT=8080
